# ---------------------------------------------------------------------------
# Daily Content Tracker - environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel set these under Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Vercel Postgres / any Postgres 14+).
# Leave empty locally to use the built-in PGlite database stored in ./.data/pglite
DATABASE_URL=

# Public base URL of the app (used for Google redirect + setup links)
APP_URL=http://localhost:3000

# --- Google sign-in (recommended: company Google Workspace) ---
# Create an OAuth client (Web application) in Google Cloud Console.
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of Google Workspace domains allowed to sign in (optional
# extra check on top of the approved-email allowlist), e.g. indglobalrealty.com
ALLOWED_GOOGLE_DOMAINS=

# --- Invitation / setup-link password sign-in (fallback) ---
# Set to "false" to disable password sign-in once Google sign-in is working.
ENABLE_PASSWORD_LOGIN=true

# First Super Admin. When nobody holds the Super Admin role yet, this address
# becomes Super Admin on first Google sign-in, or run: npm run bootstrap-admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# --- Local development only (ignored when NODE_ENV=production) ---
# Shows a "sign in as sample user" picker on the login page.
ENABLE_DEV_LOGIN=false
# Pretend the current time is this instant, to test the 7 PM cutoff, e.g.
# APP_FAKE_NOW=2026-10-12T19:05:00+04:00
APP_FAKE_NOW=
